# Copy to .env.local and fill in your MySQL details.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=moneybook
MYSQL_PASSWORD=
MYSQL_DATABASE=moneybook

# For a hosted database (TiDB Cloud, Aiven...): encrypt the connection, and
# keep the pool small on serverless hosts such as Vercel.
# MYSQL_SSL=true
# MYSQL_CONNECTION_LIMIT=2

# Where the people using the app are. The server uses it to know what "today"
# and "this month" mean (servers usually run on UTC). Any IANA zone name.
APP_TIME_ZONE=Asia/Bangkok
